<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main app theme -->
    <style name="Theme.ZivaMinistries" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/gold_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme - Works on ALL Android versions -->
    <style name="Theme.ZivaMinistries.SplashScreen" parent="Theme.SplashScreen">

        <!-- For Android 12+ (API 31+) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_bg</item>
        <item name="windowSplashScreenAnimationDuration">500</item>

        <!-- For ALL Android versions (including Android 8) -->
        <!-- This is the fallback that shows on older devices -->
        <item name="android:windowBackground">@drawable/splash_background</item>

        <!-- Status bar color for older devices -->
        <item name="android:statusBarColor">@color/splash_background</item>

    </style>

</resources>